<Project>
  <!-- Configuración común a todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- SimConnect.dll y el envoltorio administrado son x64: toda la solución corre en x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versión de la app (la muestra la interfaz y la usa el script de empaquetado, tools/package.ps1). -->
    <VersionPrefix>0.9.1</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <Product>LUAW</Product>
    <Authors>ExOBrienX</Authors>
    <Copyright>© 2026 ExOBrienX</Copyright>
  </PropertyGroup>
</Project>
